{
  "name": "dsh-llm-gateway",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "description": "把 DSH 已配置的模型共享给本机程序——无需重复配置，用 OpenAI 兼容接口直接调用",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
